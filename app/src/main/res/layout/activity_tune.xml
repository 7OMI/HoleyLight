<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/activity_layout"
    android:background="?android:attr/windowBackground"
    tools:context=".ui.TuneActivity">
    
    <TextView
        android:id="@+id/tvNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/tune_notice"
        android:gravity="center"
        android:textColor="?android:attr/textColorPrimary"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView android:id="@+id/tvAddScaleBase" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintLeft_toLeftOf="parent" />
    <TextView android:id="@+id/tvAddScaleHorizontal" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintLeft_toLeftOf="parent" />
    <TextView android:id="@+id/tvShiftVertical" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintLeft_toLeftOf="parent" />
    <TextView android:id="@+id/tvShiftHorizontal" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintLeft_toLeftOf="parent" />
    <TextView android:id="@+id/tvAddThickness" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintLeft_toLeftOf="parent" />
    <TextView android:id="@+id/tvSpeed" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintLeft_toLeftOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvNotice"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ROW 1: Scale Base -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scale Base" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnAddScaleBaseMinus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/minus" android:onClick="btnClick" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderScaleBase" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnAddScaleBasePlus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/plus" android:onClick="btnClick" />
                <EditText android:id="@+id/inputScaleBase" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned" android:gravity="center" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="32dp" android:text=" dp" android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <!-- ROW 2: Scale Horizontal -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scale Horizontal" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnAddScaleHorizontalMinus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/minus" android:onClick="btnClick" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderScaleHorizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnAddScaleHorizontalPlus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/plus" android:onClick="btnClick" />
                <EditText android:id="@+id/inputScaleHorizontal" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned" android:gravity="center" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="32dp" android:text=" dp" android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <!-- ROW 3: Shift Vertical -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shift Vertical" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnShiftVerticalMinus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/minus" android:onClick="btnClick" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderShiftVertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnShiftVerticalPlus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/plus" android:onClick="btnClick" />
                <EditText android:id="@+id/inputShiftVertical" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned" android:gravity="center" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="32dp" android:text=" dp" android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <!-- ROW 4: Shift Horizontal -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shift Horizontal" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnShiftHorizontalMinus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/minus" android:onClick="btnClick" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderShiftHorizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnShiftHorizontalPlus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/plus" android:onClick="btnClick" />
                <EditText android:id="@+id/inputShiftHorizontal" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned" android:gravity="center" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="32dp" android:text=" dp" android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <!-- ROW 5: Thickness -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thickness" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnAddThicknessMinus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/minus" android:onClick="btnClick" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderThickness" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnAddThicknessPlus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/plus" android:onClick="btnClick" />
                <EditText android:id="@+id/inputThickness" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="numberDecimal" android:gravity="center" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="32dp" android:text=" dp" android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <!-- ROW 6: Speed -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speed" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnSpeedMinus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/minus" android:onClick="btnClick" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderSpeed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <Button style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:id="@+id/btnSpeedPlus" android:layout_width="48dp" android:layout_height="wrap_content" android:text="@string/plus" android:onClick="btnClick" />
                <EditText android:id="@+id/inputSpeed" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="numberDecimal" android:gravity="center" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="32dp" android:text=" x" android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
